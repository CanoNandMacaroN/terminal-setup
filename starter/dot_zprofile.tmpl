# Package-manager paths are selected at render time for the target platform.
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- else if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") }}
if [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{- else if eq .chezmoi.os "linux" }}
export PIXI_HOME="${PIXI_HOME:-{{ .chezmoi.homeDir }}/.pixi}"
export PATH="$PIXI_HOME/bin:$PATH"
{{- end }}

export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"
