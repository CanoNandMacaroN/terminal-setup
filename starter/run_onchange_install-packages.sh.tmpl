#!/usr/bin/env bash
set -euo pipefail

# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

if [[ "$(uname -s)" != Darwin ]]; then
    echo "The Homebrew formula manifest is managed only on macOS; skipping it on this platform."
    exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "$brew_path" ]]; then
            eval "$("$brew_path" shellenv)"
            break
        fi
    done
fi

command -v brew >/dev/null 2>&1 || {
    echo "Homebrew is required before applying the Brewfile." >&2
    exit 1
}

export HOMEBREW_NO_AUTO_UPDATE=1
brew bundle install --global --no-upgrade

if [[ "${TERMINAL_SETUP_PRUNE:-0}" == 1 ]]; then
    echo "Pruning top-level Homebrew formulae not declared by the Brewfile."
    brew bundle cleanup --global --force --formula
else
    echo "Pruning disabled. Re-run setup with --prune to remove undeclared Homebrew formulae."
fi
