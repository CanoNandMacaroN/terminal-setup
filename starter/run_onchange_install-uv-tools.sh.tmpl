#!/usr/bin/env bash
set -euo pipefail

# uv tools hash: {{ include "dot_myshell/uv-tools.toml" | sha256sum }}

command -v uv >/dev/null 2>&1 || {
    echo "uv is required before applying the tool manifest." >&2
    exit 1
}

manifest="$HOME/.myshell/uv-tools.toml"
[[ -r "$manifest" ]] || {
    echo "uv tool manifest is missing: $manifest" >&2
    exit 1
}

desired_file="$(mktemp "${TMPDIR:-/tmp}/uv-desired.XXXXXX")"
current_file="$(mktemp "${TMPDIR:-/tmp}/uv-current.XXXXXX")"
trap 'rm -f -- "$desired_file" "$current_file"' EXIT

awk '
function trim(value) { sub(/^[[:space:]]+/, "", value); sub(/[[:space:]]+$/, "", value); return value }
function fail(message) { print "uv-tools.toml: " message > "/dev/stderr"; invalid=1; exit 1 }
function quoted(value, field) {
    value=trim(value)
    if (value !~ /^".*"$/) fail(field " must be quoted")
    return substr(value, 2, length(value)-2)
}
function extra_dependencies(value, inner, items, count, item_index, item, result) {
    value=trim(value)
    if (value !~ /^\[.*\]$/) fail("with must be an array")
    inner=trim(substr(value, 2, length(value)-2))
    if (inner == "") return ""
    count=split(inner, items, ",")
    result=""
    for (item_index=1; item_index<=count; item_index++) {
        item=quoted(items[item_index], "with entry")
        if (item == "" || item ~ /[[:space:]]/) fail("invalid with entry")
        result=(result == "" ? item : result "," item)
    }
    return result
}
function emit_tool() {
    if (!in_tool) return
    if (name == "" || package == "") fail("each [[tool]] needs name and package")
    if (name !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) fail("invalid tool name: " name)
    if (package ~ /[[:space:]]/) fail("invalid package for " name)
    if (seen[name]++) fail("duplicate tool name: " name)
    print name "\t" package "\t" python "\t" dependencies
    tool_count++
    name=""; package=""; python=""; dependencies=""
}
{
    line=trim($0)
    if (line == "" || line ~ /^#/) next
    if (line == "[[tool]]") { emit_tool(); in_tool=1; next }
    separator=index(line, "=")
    if (!separator) fail("invalid line: " line)
    key=trim(substr(line, 1, separator-1))
    value=trim(substr(line, separator+1))
    if (!in_tool) fail("expected [[tool]] before: " line)
    else if (key == "name") { if (name != "") fail("duplicate name"); name=quoted(value, "name") }
    else if (key == "package") { if (package != "") fail("duplicate package"); package=quoted(value, "package") }
    else if (key == "python") {
        if (python != "") fail("duplicate python")
        python=quoted(value, "python")
        if (python !~ /^[0-9]+\.[0-9]+(\.[0-9]+)?$/) fail("invalid python version: " python)
    }
    else if (key == "with") { if (dependencies != "") fail("duplicate with"); dependencies=extra_dependencies(value) }
    else fail("unknown tool key: " key)
}
END {
    if (invalid) exit 1
    emit_tool()
    if (tool_count == 0) fail("at least one [[tool]] is required")
}
' "$manifest" | LC_ALL=C sort > "$desired_file"

cut -f3 "$desired_file" | sed '/^$/d' | LC_ALL=C sort -u | while IFS= read -r python_version; do
    uv python install "$python_version"
done

uv tool list | awk 'NF && $1 != "-" { print $1 }' | LC_ALL=C sort -u > "$current_file"

while IFS=$'\t' read -r name package python with_csv; do
    args=(tool install)
    [[ -z "$python" ]] || args+=(--python "$python")
    if [[ -n "$with_csv" ]]; then
        IFS=',' read -r -a dependencies <<< "$with_csv"
        for dependency in "${dependencies[@]}"; do
            args+=(--with "$dependency")
        done
    fi
    args+=("$package" --force)
    uv "${args[@]}"
done < "$desired_file"

if [[ "${TERMINAL_SETUP_PRUNE:-0}" == 1 ]]; then
    while IFS= read -r tool; do
        [[ -n "$tool" ]] || continue
        cut -f1 "$desired_file" | grep -Fqx -- "$tool" || uv tool uninstall "$tool"
    done < "$current_file"
else
    echo "Pruning disabled. Re-run setup with --prune to remove undeclared uv tools."
fi
