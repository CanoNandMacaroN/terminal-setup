# Descr: Capture Homebrew and uv manifests into the local chezmoi source state.
# Usage: env-sync

emulate -L zsh
setopt pipe_fail local_traps

local command_name
for command_name in uv chezmoi; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        print -u2 -- "Missing command: $command_name"
        return 1
    fi
done
if [[ "$(uname -s)" == Darwin ]] && ! command -v brew >/dev/null 2>&1; then
    print -u2 -- "Missing command: brew"
    return 1
fi

local brewfile="$HOME/.Brewfile"
local uv_tools_file="$HOME/.myshell/uv-tools.toml"
local temp_dir
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/env-sync.XXXXXX")" || return 1
trap 'rm -rf -- "$temp_dir"' EXIT HUP INT TERM

local temp_brewfile="$temp_dir/Brewfile"
local temp_uv_tools="$temp_dir/uv-tools.toml"
local temp_uv_entries="$temp_dir/uv-tools.entries"

local -a managed_targets
managed_targets=("$uv_tools_file")
if [[ "$(uname -s)" == Darwin ]]; then
    print -- "Capturing Homebrew taps, top-level formulae, and casks..."
    {
        printf '# Third-party taps\n'
        brew tap | LC_ALL=C sort | sed 's/^/tap "/;s/$/"/'
        printf '\n# Top-level formulae\n'
        brew leaves | LC_ALL=C sort | sed 's/^/brew "/;s/$/"/'
        printf '\n# macOS applications\n'
        brew list --cask | LC_ALL=C sort | sed 's/^/cask "/;s/$/"/'
    } > "$temp_brewfile" || {
        print -u2 -- "Homebrew manifest capture failed; existing manifests were not changed."
        return 1
    }
    managed_targets=("$brewfile" "$uv_tools_file")
else
    print -- "Skipping the macOS-only Homebrew manifest."
fi

print -- "Capturing uv tool requirements..."
: > "$temp_uv_entries"
local receipt tool_name direct_package package_name specifier extras entry_file
for receipt in "$HOME"/.local/share/uv/tools/*/uv-receipt.toml(N); do
    tool_name="${receipt:h:t}"
    direct_package=""
    extras=()
    while IFS=$'\t' read -r package_name specifier; do
        [[ -n "$package_name" ]] || continue
        [[ "$package_name" != pyyaml ]] || package_name="PyYAML"
        if [[ "$package_name" == "$tool_name" ]]; then
            direct_package="$package_name$specifier"
        else
            extras+=("$package_name$specifier")
        fi
    done < <(sed -nE '
        s/.*name = "([^"]+)", specifier = "([^"]+)".*/\1\t\2/p
        s/.*name = "([^"]+)"[^,}]*\}.*/\1\t/p
    ' "$receipt")
    if [[ -z "$direct_package" ]]; then
        print -u2 -- "Cannot find the direct requirement for $tool_name in $receipt."
        return 1
    fi

    local python_requirement=""
    if [[ -r "$uv_tools_file" ]]; then
        python_requirement="$(awk -v wanted="$tool_name" '
            $0 == "[[tool]]" { current=""; next }
            /^name = "/ {
                current=$0
                sub(/^name = "/, "", current)
                sub(/"$/, "", current)
                next
            }
            /^python = "/ && current == wanted {
                value=$0
                sub(/^python = "/, "", value)
                sub(/"$/, "", value)
                print value
                exit
            }
        ' "$uv_tools_file")"
    fi

    entry_file="$temp_dir/uv-tool-$tool_name"
    {
        printf '[[tool]]\n'
        printf 'name = "%s"\n' "$tool_name"
        printf 'package = "%s"\n' "$direct_package"
        [[ -z "$python_requirement" ]] || printf 'python = "%s"\n' "$python_requirement"
        if (( ${#extras[@]} > 0 )); then
            printf 'with = ['
            local extra extra_index=1
            for extra in "${extras[@]}"; do
                (( extra_index > 1 )) && printf ', '
                printf '"%s"' "$extra"
                (( extra_index++ ))
            done
            printf ']\n'
        fi
        printf '\n'
    } > "$entry_file"
    printf '%s\n' "$tool_name" >> "$temp_uv_entries"
done

if [[ ! -s "$temp_uv_entries" ]]; then
    print -u2 -- "No uv tool receipts were found; existing manifests were not changed."
    return 1
fi
{
    while IFS= read -r tool_name; do
        cat "$temp_dir/uv-tool-$tool_name"
    done < <(LC_ALL=C sort -u "$temp_uv_entries")
} > "$temp_uv_tools"

mkdir -p -- "${uv_tools_file:h}"
if [[ "$(uname -s)" == Darwin ]] && ! cmp -s -- "$temp_brewfile" "$brewfile"; then
    mv -- "$temp_brewfile" "$brewfile"
    print -- "Updated $brewfile"
fi
if ! cmp -s -- "$temp_uv_tools" "$uv_tools_file"; then
    mv -- "$temp_uv_tools" "$uv_tools_file"
    print -- "Updated $uv_tools_file"
fi

chezmoi add --secrets error -- "${managed_targets[@]}" || return 1
print -- "Captured manifests into the local chezmoi source; nothing was committed or pushed."
